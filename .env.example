# DB
MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=curio
MYSQL_USER=curio
MYSQL_PASSWORD=curio1234
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=your-access-secret-key-must-be-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-key-must-be-at-least-32-chars
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# Kakao OAuth
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

# AWS S3
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=curio-bucket

# AI
OPENAI_API_KEY=your-openai-api-key

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring
SPRING_PROFILES_ACTIVE=dev
