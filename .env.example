# ─────────────────────────────────────────────────────────────
# 이 파일을 .env로 복사해서 쓰면 로컬(dev)에서 바로 동작한다.
#   cp .env.example .env   (Windows: copy .env.example .env)
# 아래 [필수] 표시된 3개만 본인 값으로 채우면 된다:
#   KAKAO_CLIENT_ID / KAKAO_CLIENT_SECRET, GEMINI_API_KEY, ADMIN_KAKAO_IDS
# 나머지는 docker-compose 기본값/개발용이라 그대로 둬도 된다.
# ⚠️ JWT 시크릿은 개발용 예시값 — 운영(prod)에선 반드시 새 난수로 교체.
# ⚠️ 실제 .env는 절대 커밋하지 않는다(.gitignore 처리됨).
# ─────────────────────────────────────────────────────────────

# DB (docker-compose 기본값 — 그대로 사용)
MYSQL_ROOT_PASSWORD=root1234
MYSQL_DATABASE=curio
MYSQL_USER=curio
MYSQL_PASSWORD=curio1234
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Redis (그대로 사용)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT (개발용 예시값 — 로컬은 그대로 OK / prod는 새 난수로 교체)
JWT_ACCESS_SECRET=dev-local-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-local-refresh-secret-change-me-0123456789abcdef
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000

# Kakao OAuth  [필수] 카카오 디벨로퍼스 앱의 값으로 교체
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

# AWS S3 (선택 — 비워두면 이미지 업로드 비활성, 로컬 개발엔 없어도 됨)
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=

# AI  [필수] Google AI Studio 무료티어 — aistudio.google.com에서 키 발급(카드 불필요)
GEMINI_API_KEY=your-gemini-api-key
# 선택: 모델 오버라이드 (기본 gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Admin  [필수] 관리자로 쓸 본인 kakao_id (users 테이블 값, 쉼표로 여러 명)
ADMIN_KAKAO_IDS=your-kakao-id

# CORS (로컬 프론트 주소 — 그대로 사용)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring (dev 프로필 — 그대로 사용)
SPRING_PROFILES_ACTIVE=dev
